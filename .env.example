# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=sqlite:///donations.db
# For PostgreSQL: postgresql://username:password@localhost/donation_db

# Blockchain Configuration
# Options: localhost (Hardhat local), sepolia (testnet), mumbai (Polygon testnet)
ETHEREUM_NETWORK=localhost
INFURA_PROJECT_ID=your-infura-project-id
PRIVATE_KEY=your-ethereum-private-key
CONTRACT_ADDRESS=your-deployed-contract-address

# For Local Hardhat Development (no Infura/Private Key needed):
# 1. Set ETHEREUM_NETWORK=localhost
# 2. Run: npx hardhat node (in separate terminal)
# 3. Run: npm run deploy:local
# 4. Contract address will be auto-updated in .env

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# NGO Information
NGO_NAME=Your NGO Name
NGO_EMAIL=ngo@example.com
NGO_ADDRESS=Your NGO Address
NGO_PAN=AAAAA0000A
NGO_REGISTRATION=REG123456

# Frontend URL
FRONTEND_URL=http://localhost:3000

# AI/OCR Configuration
OCR_CONFIDENCE_THRESHOLD=0.6